diff --git a/chargehold/chargehold.sh b/chargehold/chargehold.sh
new file mode 100644
index 0000000..3d38bb7
--- /dev/null
+++ b/chargehold/chargehold.sh
@@ -0,0 +1,43 @@
+#!/vendor/bin/sh
+# chargehold: battery-health charge limit + plugged-in performance profile for gts3l.
+# Settings (persist.sys.chghold.*, written by the ChargeHold settings page):
+#   enabled (1)  max (80)  min (75)  temp_max (40, degC battery)  perf_plugged (0)
+B=/sys/class/power_supply/battery
+CB=/sys/module/cpu_boost/parameters
+G=/sys/class/kgsl/kgsl-3d0
+p(){ v=$(getprop persist.sys.chghold.$1); echo "${v:-$2}"; }
+w(){ [ "$(cat $1 2>/dev/null)" = "$2" ] || echo "$2" > $1; }
+LAST_HMT=
+lg(){ /system/bin/log -t chargehold "$*"; }
+# remember stock tunables once
+BOOST_FREQ=$(cat $CB/input_boost_freq | tr -s " " | sed "s/ *$//")
+BOOST_MS=$(cat $CB/input_boost_ms); GPU_LVL=$(cat $G/default_pwrlevel)
+# if restarted while the plugged profile was active, fall back to the init.qcom.power.rc values
+[ "$BOOST_MS" = 800 ] && { BOOST_FREQ="0:1324800 2:1555200"; BOOST_MS=500; GPU_LVL=6; }
+hold=0; perf=0; state=""
+while true; do
+  en=$(p enabled 1); max=$(p max 80); min=$(p min 75); tmax=$(p temp_max 40); pp=$(p perf_plugged 0)
+  [ $min -ge $max ] && min=$((max-5))
+  cap=$(cat $B/capacity); t=$(( $(cat $B/temp) / 10 )); src=$(cat $B/online)
+  plugged=0; [ "$src" != 1 ] && [ "$src" != 0 ] && plugged=1
+  # --- charge hold (hysteresis); also pause charging when the battery is hot
+  if [ $en = 1 ] && [ $plugged = 1 ]; then
+    if [ $cap -ge $max ] || [ $t -ge $tmax ]; then hold=1
+    elif [ $cap -le $min ] && [ $t -lt $((tmax-3)) ]; then hold=0; fi
+  else hold=0; fi
+  # above the limit (e.g. plugged in at 100 %): run from the battery until it is back at the
+  # limit (Samsung store_mode turns the charger power path off above 70 %); otherwise the bypass would keep it full forever
+  drain=0; [ $en = 1 ] && [ $plugged = 1 ] && [ $cap -gt $max ] && drain=1
+  w $B/store_mode $drain
+  # hmt_ta_charge cannot be read back (always 0 here), so remember the last value written instead of comparing with the node
+  [ "$LAST_HMT" = "$((1-hold))" ] || { echo $((1-hold)) > $B/hmt_ta_charge; LAST_HMT=$((1-hold)); }
+  # --- plugged-in performance profile, dropped when hot
+  if [ $pp = 1 ] && [ $plugged = 1 ] && [ $t -lt $tmax ]; then
+    perf=1; w $CB/input_boost_freq "0:1593600 2:1996800"; w $CB/input_boost_ms 800; w $G/default_pwrlevel 4
+  elif [ $perf = 1 ]; then
+    perf=0; w $CB/input_boost_freq "$BOOST_FREQ"; w $CB/input_boost_ms $BOOST_MS; w $G/default_pwrlevel $GPU_LVL
+  fi
+  s="plugged=$plugged cap=$cap t=$t hold=$hold drain=$drain perf=$perf"
+  [ "$s" != "$state" ] && { lg "$s (band $min-$max, tmax $tmax)"; state=$s; setprop vendor.chghold.state "$s"; }
+  sleep 20
+done
