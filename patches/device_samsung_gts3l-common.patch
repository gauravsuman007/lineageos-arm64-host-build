diff --git a/chargehold/app/src/org/lineageos/chargehold/ChargeHoldActivity.java b/chargehold/app/src/org/lineageos/chargehold/ChargeHoldActivity.java
new file mode 100644
index 0000000..828f36f
--- /dev/null
+++ b/chargehold/app/src/org/lineageos/chargehold/ChargeHoldActivity.java
@@ -0,0 +1,95 @@
+package org.lineageos.chargehold;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.SystemProperties;
+import android.preference.ListPreference;
+import android.preference.Preference;
+import android.preference.PreferenceFragment;
+import android.preference.SwitchPreference;
+
+public class ChargeHoldActivity extends Activity {
+    static final String P = "persist.sys.chghold.";
+
+    @Override
+    protected void onCreate(Bundle b) {
+        super.onCreate(b);
+        getActionBar().setDisplayHomeAsUpEnabled(true);
+        if (b == null) {
+            getFragmentManager().beginTransaction()
+                    .replace(android.R.id.content, new Prefs()).commit();
+        }
+    }
+
+    @Override
+    public boolean onNavigateUp() { finish(); return true; }
+
+    public static class Prefs extends PreferenceFragment
+            implements Preference.OnPreferenceChangeListener {
+        private final Handler mH = new Handler();
+        private Preference mStatus;
+        private final Runnable mTick = new Runnable() {
+            public void run() {
+                String s = SystemProperties.get("vendor.chghold.state", "service not running");
+                mStatus.setSummary(s.replace("plugged=", "charger ").replace(" cap=", ", battery ")
+                        .replace(" t=", " %, ").replace(" hold=1", " °C, charging paused")
+                        .replace(" hold=0", " °C, charging allowed").replace(" drain=1", ", running on battery down to the limit").replace(" drain=0", "")
+                        .replace(" perf=1", ", boost on")
+                        .replace(" perf=0", ", boost off").replace("charger 1", "charger connected")
+                        .replace("charger 0", "on battery"));
+                mH.postDelayed(this, 2000);
+            }
+        };
+
+        @Override
+        public void onCreate(Bundle b) {
+            super.onCreate(b);
+            addPreferencesFromResource(R.xml.prefs);
+            int max = SystemProperties.getInt(P + "max", 80);
+            int min = SystemProperties.getInt(P + "min", 75);
+            bindSwitch("enabled", SystemProperties.getInt(P + "enabled", 1) == 1);
+            bindList("max", String.valueOf(max));
+            bindList("gap", String.valueOf(Math.max(3, max - min)));
+            bindList("temp_max", String.valueOf(SystemProperties.getInt(P + "temp_max", 40)));
+            bindSwitch("perf_plugged", SystemProperties.getInt(P + "perf_plugged", 0) == 1);
+            mStatus = findPreference("status");
+        }
+
+        private void bindSwitch(String k, boolean v) {
+            SwitchPreference p = (SwitchPreference) findPreference(k);
+            p.setChecked(v);
+            p.setOnPreferenceChangeListener(this);
+        }
+
+        private void bindList(String k, String v) {
+            ListPreference p = (ListPreference) findPreference(k);
+            p.setValue(v);
+            p.setOnPreferenceChangeListener(this);
+        }
+
+        @Override
+        public boolean onPreferenceChange(Preference p, Object v) {
+            String k = p.getKey();
+            if (v instanceof Boolean) {
+                SystemProperties.set(P + k, (Boolean) v ? "1" : "0");
+            } else if (k.equals("max") || k.equals("gap")) {
+                int max = Integer.parseInt(k.equals("max") ? (String) v
+                        : ((ListPreference) findPreference("max")).getValue());
+                int gap = Integer.parseInt(k.equals("gap") ? (String) v
+                        : ((ListPreference) findPreference("gap")).getValue());
+                SystemProperties.set(P + "max", String.valueOf(max));
+                SystemProperties.set(P + "min", String.valueOf(max - gap));
+            } else {
+                SystemProperties.set(P + k, (String) v);
+            }
+            return true;
+        }
+
+        @Override
+        public void onResume() { super.onResume(); mH.post(mTick); }
+
+        @Override
+        public void onPause() { super.onPause(); mH.removeCallbacks(mTick); }
+    }
+}
