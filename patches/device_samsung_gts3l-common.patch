diff --git a/rootdir/etc/init.qcom.power.rc b/rootdir/etc/init.qcom.power.rc
index e30de92..63f3788 100644
--- a/rootdir/etc/init.qcom.power.rc
+++ b/rootdir/etc/init.qcom.power.rc
@@ -120,14 +120,14 @@ on enable-low-power
 
     # Configure governor settings for little cluster
     write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "blu_schedutil"
-    write /sys/devices/system/cpu/cpu0/cpufreq/blu_schedutil/up_rate_limit_us 250
-    write /sys/devices/system/cpu/cpu0/cpufreq/blu_schedutil/down_rate_limit_us 10000
+    write /sys/devices/system/cpu/cpu0/cpufreq/blu_schedutil/up_rate_limit_us 0
+    write /sys/devices/system/cpu/cpu0/cpufreq/blu_schedutil/down_rate_limit_us 40000
     write /sys/devices/system/cpu/cpu0/cpufreq/blu_schedutil/iowait_boost_enable 1
 
     # Configure governor settings for big cluster
     write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor "blu_schedutil"
-    write /sys/devices/system/cpu/cpu2/cpufreq/blu_schedutil/up_rate_limit_us 250
-    write /sys/devices/system/cpu/cpu2/cpufreq/blu_schedutil/down_rate_limit_us 10000
+    write /sys/devices/system/cpu/cpu2/cpufreq/blu_schedutil/up_rate_limit_us 0
+    write /sys/devices/system/cpu/cpu2/cpufreq/blu_schedutil/down_rate_limit_us 40000
     write /sys/devices/system/cpu/cpu2/cpufreq/blu_schedutil/iowait_boost_enable 1
 
     # Set boottime stune value
@@ -136,7 +136,7 @@ on enable-low-power
 
     # set default schedTune value for foreground/top-app (only affects EAS)
     write /dev/stune/foreground/schedtune.prefer_idle 1
-    write /dev/stune/top-app/schedtune.boost 10
+    write /dev/stune/top-app/schedtune.boost 20
     write /dev/stune/top-app/schedtune.prefer_idle 1
     write /dev/stune/rt/schedtune.boost 30
     write /dev/stune/rt/schedtune.prefer_idle 1
@@ -145,11 +145,11 @@ on enable-low-power
     write /sys/module/msm_thermal/core_control/enabled 1
 
     # Dynamic stune boost config
-    write /sys/module/cpu_boost/parameters/dynamic_stune_boost 10
+    write /sys/module/cpu_boost/parameters/dynamic_stune_boost 20
 
     # Input boost config
-    write /sys/module/cpu_boost/parameters/input_boost_freq "0:1324800 2:1324800"
-    write /sys/module/cpu_boost/parameters/input_boost_ms 40
+    write /sys/module/cpu_boost/parameters/input_boost_freq "0:1324800 2:1555200"
+    write /sys/module/cpu_boost/parameters/input_boost_ms 500
 
     # Enable bus-dcvs
     write /sys/class/devfreq/soc:qcom,cpubw/governor "bw_hwmon"
@@ -208,3 +208,7 @@ service charger /system/bin/lpm
     group system radio graphics input
     capabilities SYS_BOOT
     seclabel u:r:charger:s0
+
+# libperfmgr power HAL: start hint manager once boot is done
+on property:sys.boot_completed=1
+    setprop vendor.powerhal.init 1
diff --git a/sepolicy/chargehold.te b/sepolicy/chargehold.te
new file mode 100644
index 0000000..458ed35
--- /dev/null
+++ b/sepolicy/chargehold.te
@@ -0,0 +1,16 @@
+type chargehold, domain;
+type chargehold_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(chargehold)
+
+allow chargehold vendor_shell_exec:file rx_file_perms;
+allow chargehold vendor_toolbox_exec:file rx_file_perms;
+allow chargehold sysfs:file rw_file_perms;
+allow chargehold sysfs_batteryinfo:dir r_dir_perms;
+allow chargehold sysfs_batteryinfo:file rw_file_perms;
+allow chargehold sysfs_kgsl:dir r_dir_perms;
+allow chargehold sysfs_kgsl:file rw_file_perms;
+allow chargehold sysfs_devices_system_cpu:file r_file_perms;
+set_prop(chargehold, vendor_powerhal_prop)
+get_prop(chargehold, system_prop)
+allow chargehold sysfs_cpu_boost:dir r_dir_perms;
+allow chargehold sysfs_cpu_boost:file rw_file_perms;
