diff --git a/core/envsetup.mk b/core/envsetup.mk
index f4650f9..2a7ce59 100644
--- a/core/envsetup.mk
+++ b/core/envsetup.mk
@@ -129,12 +129,14 @@ HOST_CROSS_OS :=
 # We can cross-build Windows binaries on Linux
 ifeq ($(HOST_OS),linux)
 ifeq ($(BUILD_HOST_static),)
+ifeq (,$(findstring aarch64,$(UNAME)))
 HOST_CROSS_OS := windows
 HOST_CROSS_ARCH := x86
 HOST_CROSS_2ND_ARCH := x86_64
 2ND_HOST_CROSS_IS_64_BIT := true
 endif
 endif
+endif
 
 ifeq ($(HOST_OS),)
 $(error Unable to determine HOST_OS from uname -sm: $(UNAME)!)
@@ -146,10 +148,16 @@ ifneq (,$(findstring x86_64,$(UNAME)))
   HOST_2ND_ARCH := x86
   HOST_IS_64_BIT := true
 else
+ifneq (,$(findstring aarch64,$(UNAME)))
+  HOST_ARCH := arm64
+  HOST_2ND_ARCH :=
+  HOST_IS_64_BIT := true
+else
 ifneq (,$(findstring i686,$(UNAME))$(findstring x86,$(UNAME)))
 $(error Building on a 32-bit x86 host is not supported: $(UNAME)!)
 endif
 endif
+endif
 
 ifeq ($(HOST_OS),darwin)
   # Mac no longer supports 32-bit executables
